# LumoraAI Root Environment Variables Template
# Copy this file to .env and configure your local environment values.

# ==============================================================================
# Frontend Settings (Next.js)
# ==============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ==============================================================================
# Backend Server Settings (FastAPI)
# ==============================================================================
PORT=8000
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
PRESENTATION_MODE=false

# ==============================================================================
# Google Gemini AI Configuration
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# ==============================================================================
# Secondary AI Provider Configuration (OpenRouter Fallback)
# ==============================================================================
SECONDARY_AI_PROVIDER_NAME=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
SECONDARY_AI_BASE_URL=https://openrouter.ai/api/v1
SECONDARY_AI_MODEL=qwen/qwen3.8-27b:free

# ==============================================================================
# Supabase PostgreSQL & Storage Configuration
# ==============================================================================
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=workspace-documents
