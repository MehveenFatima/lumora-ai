# LumoraAI environment template
# Copy to `.env` in the repository root and fill in your own values.
# The backend reads `.env` from the repository root and from `backend/.env`.
# Never commit a real `.env` file.

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------------------
# Where the Next.js /api/v1 proxy forwards requests (the FastAPI server)
BACKEND_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Backend (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
# Extra origin allowed by CORS (localhost:3000 is always allowed)
FRONTEND_ORIGIN=http://localhost:3000
# When true, the API refuses to run without a PostgreSQL connection
PRESENTATION_MODE=false

# ------------------------------------------------------------------------------
# Accounts & sessions
# ------------------------------------------------------------------------------
# Required in production: a long random secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=
SESSION_TTL_HOURS=168
# Set to false only for local HTTP testing in production mode (defaults to true in production)
# COOKIE_SECURE=true
ALLOW_REGISTRATION=true

# ------------------------------------------------------------------------------
# Email (verification codes and password reset)
# ------------------------------------------------------------------------------
# Leave all of these empty to run without email: sign-up then signs in directly and
# "Forgot password" is hidden. Configure ONE provider to switch email features on.
#
# Option A, Brevo (recommended for Render's free tier, which blocks SMTP ports):
#   free plan, verify one sender address in Brevo, then create an API key.
BREVO_API_KEY=
# Option B, SMTP (e.g. Gmail with an App Password; good for local development):
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# The sender shown on emails (must be the verified sender for Brevo, or your Gmail address)
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=LumoraAI
# auto = require verification whenever a provider is configured; false = never require it
EMAIL_VERIFICATION=auto

# Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Secondary provider used for failover (OpenRouter or any OpenAI-compatible API)
SECONDARY_AI_PROVIDER_NAME=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
SECONDARY_AI_BASE_URL=https://openrouter.ai/api/v1
SECONDARY_AI_MODEL=qwen/qwen3.8-27b:free

# Supabase PostgreSQL (with pgvector) and Storage
# Leave DATABASE_URL empty to run with the in-memory fallback store.
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=workspace-documents

# Retrieval
RAG_TOP_K=5
MAX_CONTEXT_TOKENS=3500
CONVERSATION_HISTORY_LIMIT=8
