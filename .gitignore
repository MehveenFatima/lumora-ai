!.env.example
!backend/.env.example
!**/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor & OS Metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# SSL / TLS Certificates & Private Keys
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# Vercel
.vercel

