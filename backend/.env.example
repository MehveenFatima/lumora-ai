# LumoraAI Backend Environment Configuration

# Server Settings
PORT=8000
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000

# Google Gemini API
# Get your API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Secondary AI Provider (OpenRouter / Fallback)
# Get your API key at https://openrouter.ai/
SECONDARY_AI_PROVIDER_NAME=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
SECONDARY_AI_BASE_URL=https://openrouter.ai/api/v1
SECONDARY_AI_MODEL=qwen/qwen3.8-27b:free

# Supabase Credentials & Database Connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres
SUPABASE_STORAGE_BUCKET=workspace-documents

# RAG & Retrieval Parameters
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
MAX_CONTEXT_TOKENS=3500
CONVERSATION_HISTORY_LIMIT=8
