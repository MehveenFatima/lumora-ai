# LumoraAI backend environment template
# Copy to `backend/.env` (or use the repository-root `.env.example`, which also
# covers the frontend). Never commit a real `.env` file.

ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
PRESENTATION_MODE=false

# Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Secondary provider used for failover (OpenRouter or any OpenAI-compatible API)
SECONDARY_AI_PROVIDER_NAME=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
SECONDARY_AI_BASE_URL=https://openrouter.ai/api/v1
SECONDARY_AI_MODEL=qwen/qwen3.8-27b:free

# Supabase PostgreSQL (with pgvector) and Storage
# Leave DATABASE_URL empty to run with the in-memory fallback store.
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=workspace-documents

# Retrieval
RAG_TOP_K=5
MAX_CONTEXT_TOKENS=3500
CONVERSATION_HISTORY_LIMIT=8
